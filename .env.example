# Réglages de Heritage. Copier ce fichier en ".env" (jamais dans git : il est ignoré)
# puis lancer avec :  node --env-file=.env src/server.js   (Node 20.6 ou plus)
# Aucune de ces variables n'est obligatoire pour tester en local.

PORT=3000

# --- Commande par email (étape 5) ---
# Sans SMTP_HOST, aucun email ne part : chaque commande est écrite dans outbox/ (mode test).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Heritage <commandes@votre-domaine.com>
# Adresse qui reçoit les commandes
ADMIN_EMAIL=

# --- Commande par WhatsApp ---
# Numéro au format international, chiffres uniquement
WHATSAPP_NUMBER=237659855617

# Façons de commander : email,whatsapp (email = bouton principal) ou whatsapp seul
ORDER_MODES=email,whatsapp

# --- Administration (/admin, etape 6) ---
# Au premier demarrage, un mot de passe temporaire est affiche UNE fois dans la console (identifiant : admin).
# Mot de passe oublie : npm run admin:reset
# Facultatif : imposer le premier mot de passe (12 caracteres minimum, sinon un temporaire est genere)
# ADMIN_INITIAL_PASSWORD=
# Dossier des photos envoyees (a placer sur un disque persistant en production)
# UPLOAD_DIR=
# Derriere un proxy HTTPS (Nginx, hebergeur) : nombre de proxys de confiance, pour voir la vraie IP des visiteurs
# TRUST_PROXY=1
# En production : NODE_ENV=production (cookie de session "Secure")
